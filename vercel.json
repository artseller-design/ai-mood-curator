{
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "static/**",
        "templates/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}